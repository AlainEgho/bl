# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=egho
DB_DATABASE=backend

# Auth: token validation API (default: https://localhost:8081/api/auth/validate-token)
# AUTH_VALIDATE_TOKEN_URL=https://localhost:8081/api/auth/validate-token
# Set to 1 or true to allow self-signed/invalid TLS when calling auth over HTTPS (dev only)
# AUTH_VALIDATE_INSECURE_SSL=1

# Image uploads root (for GET /i/:code). Default: C:\AI\backend\uploads\images
# IMAGE_UPLOAD_ROOT=C:\AI\backend\uploads\images

# Optional: set to "production" to disable schema auto-sync
# NODE_ENV=development

# Logging (optional)
# LOG_LEVEL=debug
# LOG_TO_FILE=true
# LOG_DIR=logs
# LOG_FILE=api.log
